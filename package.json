{
  "name": "mangystau-logistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Freight dispatcher for intra-regional and last-mile transport in Mangystau Region, Kazakhstan.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "data:settlements": "node scripts/fetch-settlements.mjs",
    "data:matrix": "node scripts/build-distance-matrix.mjs",
    "db:seed": "node scripts/seed.ts",
    "db:seed:remote": "node --env-file=.env.local scripts/seed.ts",
    "check:dispatch": "node scripts/check-dispatch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@electric-sql/pglite": "^0.3.14",
    "@neondatabase/serverless": "^1.0.2",
    "leaflet": "1.9.4",
    "next": "^16.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "^8.5.25",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
