# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Leave empty to use the local PGlite database in .pgdata/ instead,
# which is a real Postgres and runs the same SQL.
# Neon gives you a string shaped like:
#   postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Anthropic key for turning a free-text message into a structured order.
# Without it the app falls back to the deterministic parser, which works but is
# less forgiving of unusual phrasing.
ANTHROPIC_API_KEY=
